{
  "mcpServers": {
    "azure-readonly": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@3.0.0", "server", "start", "--read-only", "--disable-proxy-tools"],
      "tools": ["*"]
    },
    "@merill/lokka@latest": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@merill/lokka@latest"]
    }
  }
}
